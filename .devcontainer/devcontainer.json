{
  "name": "FANUC ROS 2 Jazzy",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "remoteUser": "dev",
  "runArgs": ["--shm-size=1g"],
  "hostRequirements": { "cpus": 4 },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": { "label": "Desktop (noVNC)", "onAutoForward": "notify" }
  },
  "postStartCommand": "nohup /home/dev/start.sh > /tmp/desktop.log 2>&1 &",
  "customizations": {
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
